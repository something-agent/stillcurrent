# Public receive address (no private key is ever needed by the seller)
PAY_TO=0x33190c9D2662F94A19CE88EA666f0ff8CeDe3700
# CAIP-2 network: eip155:8453 = Base mainnet; eip155:84532 = Base Sepolia (testnet)
X402_NETWORK=eip155:8453
# PayAI facilitator: no account/API key (free credits per payTo, then prepaid credits)
FACILITATOR_URL=https://facilitator.payai.network
PRICE_URL_CHECK=$0.01
PRICE_CITATION_CHECK=$0.02
# Public HTTPS origin once deployed (used in 402 resource.url and discovery docs + bot User-Agent contact)
PUBLIC_BASE_URL=https://your-service.onrender.com
# TEST MODE ONLY: 1 disables the payment gate. Never set on a public deployment.
X402_DISABLED=0
DEMO_ENABLED=1
# Operator contact: OpenAPI info.contact (x402scan) and outbound User-Agent (Wikimedia policy)
CONTACT_EMAIL=something+agent@mail.grokbot.com
