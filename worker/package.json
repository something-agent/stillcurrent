{
  "name": "stillcurrent-worker",
  "version": "0.4.2",
  "description": "StillCurrent x402 pay-per-call URL freshness and citation checks on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p test",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "probe": "bash scripts/probe_local.sh"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/hono": "^2.28.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.86.0"
  },
  "private": true
}
